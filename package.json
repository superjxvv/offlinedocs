{
  "name": "offlinedocs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @offlinedocs/shared build && pnpm --filter @offlinedocs/fetcher --filter @offlinedocs/server build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:fetcher": "pnpm --filter @offlinedocs/fetcher dev",
    "dev:server": "pnpm --filter @offlinedocs/server dev",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
