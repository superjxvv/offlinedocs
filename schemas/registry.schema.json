{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundleFormatVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "llms-txt",
              "github",
              "context7"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "minLength": 1
          },
          "lastFetched": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "minLength": 1
          },
          "chunkCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "checksums": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "sourceType",
          "sourceUrl",
          "lastFetched",
          "contentHash",
          "chunkCount",
          "checksums"
        ],
        "additionalProperties": false
      }
    },
    "fileCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "bundleFormatVersion",
    "libraries",
    "fileCount",
    "generatedAt"
  ],
  "additionalProperties": false
}
